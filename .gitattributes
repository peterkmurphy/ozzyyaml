# Normalize text files to LF in the repository and working tree.
* text=auto eol=lf

# Explicit text types
*.rs text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.sh text eol=lf
*.txt text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf

# Binary / don't touch
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.so binary
*.dylib binary
*.dll binary
*.whl binary
